# Optional overrides for docker compose (copy to .env). Defaults work out of the box.

# Database (internal to the compose network)
DB_NAME=srm_credit_engine
DB_USER=srm
DB_PASSWORD=srm

# Backend
SPRING_PROFILES_ACTIVE=docker,demo
FX_SYNC_ENABLED=true
FRANKFURTER_BASE_URL=https://api.frankfurter.dev/v1

# Host ports
API_PORT=8080
WEB_PORT=3000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# Grafana admin (anonymous read-only access is enabled for the dashboard)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
